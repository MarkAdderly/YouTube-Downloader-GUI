<controls:MicaWindow x:Class="YT_DLP_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YT_DLP_GUI"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d" ui:ThemeManager.RequestedTheme="Dark"
        Title="YouTube Downloader" Height="650" Width="500" Icon="img/icon.ico"
        d:Background="#202020"
        SystemBackdropType="Tabbed" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Topmost="False">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0"
                      CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Grid ClipToBounds="True">
        <Grid x:Name="MainViewGrid">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainTranslate" X="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="25,20,25,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,5,0,15">
                    <TextBlock Text="YouTube Downloader" FontSize="42" FontWeight="Black" HorizontalAlignment="Center" Foreground="White"/>

                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock x:Name="UrlLabel" Text="Ссылка на видео:" Margin="0,0,0,4" Opacity="0.8" FontWeight="Medium"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlTextBox" Grid.Column="0" ui:ControlHelper.PlaceholderText="https://www.youtube.com/watch?v=..." Height="36" VerticalContentAlignment="Center" TextChanged="UrlTextBox_TextChanged"/>

                        <controls:Button x:Name="PasteButton" Grid.Column="1" Width="36" Height="36" Margin="5,0,0,0" Visibility="Collapsed" Click="PasteButton_Click" Background="#33FFFFFF">
                            <ui:SymbolIcon Symbol="Paste"/>
                        </controls:Button>
                    </Grid>
                </StackPanel>

                <Grid x:Name="PreviewPanel" Grid.Row="2" Margin="0,0,0,15" Visibility="Collapsed" Height="88">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="156"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" ClipToBounds="True" Background="#22FFFFFF" Grid.Column="0">
                        <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="PreviewTitle" Grid.Column="1" Text="Загрузка информации..." TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.9" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                    <TextBlock x:Name="SaveLabel" Text="Место сохранения:" Margin="0,0,0,4" Opacity="0.8" FontWeight="Medium"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SavePathTextBox" Grid.Column="0" Height="36" Margin="0,0,5,0" VerticalContentAlignment="Center"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False" Focusable="False" Cursor="Hand"
                                 PreviewMouseLeftButtonUp="SavePathTextBox_PreviewMouseLeftButtonUp"/>
                        <controls:Button x:Name="OpenFolderButton" Grid.Column="1" Width="36" Height="36" Padding="0" VerticalAlignment="Center" Click="OpenFolderButton_Click">
                            <ui:SymbolIcon Symbol="Folder"/>
                        </controls:Button>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Bottom">
                        <TextBlock x:Name="ModeLabel" Text="Режим загрузки:" Margin="0,0,0,3" Opacity="0.8" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal" Height="36">
                            <RadioButton x:Name="RadioVideo" Content="Видео" IsChecked="True" MinWidth="0" Margin="0,0,12,0" Checked="RadioMode_Checked" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioAudio" Content="Аудио" MinWidth="0" Checked="RadioMode_Checked" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock x:Name="ComboLabel" Text="Качество:" Margin="0,0,0,3" Opacity="0.8" FontWeight="Medium"/>
                        <ComboBox x:Name="SettingsComboBox" HorizontalAlignment="Stretch" Height="36" SelectedIndex="0"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="OptionsPanel" Grid.Row="5" Margin="0,0,0,10">
                    <TextBlock x:Name="OptionsLabel" Text="Настройки загрузки:" Margin="0,0,0,0" Opacity="0.8" FontWeight="Medium"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="VideoOnlyCheckBox" Content="Только видеоряд (без звука)" MinWidth="0" Margin="0,0,15,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="6" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="StatusTextBlock" Text="" Visibility="Collapsed" TextAlignment="Center" FontSize="14" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="OperationProgressBar" Height="10" HorizontalAlignment="Stretch" Value="0" Maximum="100" IsIndeterminate="False" Visibility="Collapsed" ui:ControlHelper.CornerRadius="5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="7" Margin="0,0,0,20">
                    <controls:Button x:Name="DownloadButton" Content="НАЧАТЬ ЗАГРУЗКУ" Height="50" FontWeight="Bold" HorizontalAlignment="Stretch" ui:ControlHelper.CornerRadius="8" Click="DownloadButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" x:Name="Separator" Opacity="0.15" Fill="White" Height="1" HorizontalAlignment="Stretch"/>
                <Grid Grid.Row="1" Margin="15,0,0,0">
                    <TextBlock x:Name="RemainValue" Text="v1.1.0" FontSize="12" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                    <ui:CommandBar x:Name="ABCB" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Right" Margin="0,0,0,0">
                        <ui:AppBarButton x:Name="updateButton" Icon="Download" Visibility="Collapsed" Click="UpdateButton_Click"/>
                        <ui:AppBarButton x:Name="settingsButton" Icon="Setting" Label="О программе" Click="SettingsButton_Click"/>
                    </ui:CommandBar>
                </Grid>
            </Grid>
        </Grid>

        <Frame x:Name="SettingsFrame" Source="SettingsPage.xaml" NavigationUIVisibility="Hidden" Background="Transparent">
            <Frame.RenderTransform>
                <TranslateTransform x:Name="SettingsTranslate" X="500"/>
            </Frame.RenderTransform>
        </Frame>

    </Grid>
</controls:MicaWindow>